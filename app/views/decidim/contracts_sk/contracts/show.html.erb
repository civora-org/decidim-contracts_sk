<%# The centered single-column container the host layout partial
    (layouts/decidim/shared/layout_center) would emit: the compiled classes
    are used directly so the engine keeps no view-path dependency on the
    host's layout partials. cols-10: the record reads as a main column plus
    a key-facts panel on lg+, stacked (facts first) below. Layout styling
    comes from the engine's own scoped stylesheet (see
    shared/_public_styles for why not Tailwind utilities).

    Heading decorators (.title-decorator / .decorator) draw their bar BELOW
    the heading box; every decorated heading carries its own bottom margin
    there, so the bar never strikes through the line that follows. %>
<%= render "decidim/contracts_sk/shared/public_styles" %>
<main class="layout-1col cols-10">
  <div class="cs-page">
    <h1 class="title-decorator"><%= @contract.title %></h1>
    <%# Quick-scan identity line under the title: the record's reference and
        publication date (guarded, civora-org/civora-platform#80: a sparse
        record renders no dangling date span). The amount lives in the
        facts panel, where it is the headline figure; provenance has its
        own notice below. %>
    <div class="cs-meta">
      <span><%= t("decidim.contracts_sk.contract.reference_number") %>: <strong><%= @contract.reference %></strong></span>
      <% if @contract.published_at.present? %>
        <span><%= t("decidim.contracts_sk.contract.published_on") %>: <%= format_date(@contract.published_at) %></span>
      <% end %>
    </div>

    <div class="cs-detail">
      <%# Key facts. Each label/value pair has its own wrapper, so a long
          value can never drift into a neighbouring pair's cell. The
          optional pairs are rendered only when the value is present
          (civora-org/civora-platform#80) — the frozen-snapshot section and
          the PDF export already drop blank rows, so the live panel must not
          render empty values and dangling currency labels for sparse
          records. The reference stays unconditional: identity is NOT NULL.
          Dates and amounts render through the shared locale-aware helpers
          (civora-org/civora-platform#81). First in the DOM (read first on
          phones); the right-hand column on lg+. %>
      <aside class="cs-facts" aria-labelledby="contract-facts">
        <h2 id="contract-facts" class="cs-facts__title"><%= t("decidim.contracts_sk.contracts.show.facts") %></h2>
        <dl class="cs-dl">
          <% if @contract.amount.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.amount") %></dt>
              <dd class="cs-dl__figure"><%= format_amount(@contract.amount, @contract.currency) %></dd>
            </div>
          <% end %>

          <div>
            <dt><%= t("decidim.contracts_sk.contract.reference_number") %></dt>
            <dd><%= @contract.reference %></dd>
          </div>

          <% if @contract.published_at.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.published_on") %></dt>
              <dd><%= format_date(@contract.published_at) %></dd>
            </div>
          <% end %>

          <% if @contract.signed_on.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.signed_on") %></dt>
              <dd><%= format_date(@contract.signed_on) %></dd>
            </div>
          <% end %>

          <% if @contract.effective_from.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.effective_from") %></dt>
              <dd><%= format_date(@contract.effective_from) %></dd>
            </div>
          <% end %>

          <%# The originally guarded field: a link to a blank URL would
              render href="". The full URL stays visible (it is the
              citation) and breaks anywhere, so it cannot overflow. %>
          <%# A record CONFIRMED as filed (crz_filed_at, civora-org/civora-platform
              #125) says so, with the CRZ publication date when CRZ carried one,
              and links the official record; the guarded plain-URL row below
              stays for every other record. %>
          <% if @contract.crz_filed_at.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.crz_filed") %></dt>
              <dd>
                <% if @contract.crz_published_on.present? %>
                  <%= t("decidim.contracts_sk.contract.crz_filed_on", date: format_date(@contract.crz_published_on)) %>
                <% else %>
                  <%= t("decidim.contracts_sk.contract.crz_filed_confirmed") %>
                <% end %>
                <% if @contract.crz_url.present? %>
                  <br><%= link_to @contract.crz_url, @contract.crz_url %>
                <% end %>
              </dd>
            </div>
          <% elsif @contract.crz_url.present? %>
            <div>
              <dt><%= t("decidim.contracts_sk.contract.crz_url") %></dt>
              <dd><%= link_to @contract.crz_url, @contract.crz_url %></dd>
            </div>
          <% end %>
        </dl>
      </aside>

      <div class="cs-main">
        <% if @contract.subject_matter.present? %>
          <section>
            <h2 class="cs-subject__label"><%= t("decidim.contracts_sk.contract.subject_matter") %></h2>
            <p class="cs-subject__text"><%= @contract.subject_matter %></p>
          </section>
        <% end %>

        <%# CRZ-mirror provenance block (civora-org/civora-platform#88).
            ADR-002 rule 1: mirrored records are externally confirmed data,
            never a legal publication — the canonical record lives at
            crz.gov.sk. ADR-008 decisions 4/6: the mirror's freshness is
            signalled (never implied to be real-time) and the source
            attribution is preserved verbatim. The block covers the whole
            record. Editorial records never render it. The stale line
            appears only when mirror_stale? fires (failed re-import,
            unprovable freshness or age beyond
            Decidim::ContractsSk.stale_after) and is set apart as Decidim's
            warning label. %>
        <% if imported_contract?(@contract) %>
          <section class="cs-notice" aria-labelledby="contract-provenance">
            <%= contracts_icon(:information) %>
            <div class="cs-notice__body">
              <div>
                <h2 id="contract-provenance" class="cs-notice__title"><%= t("decidim.contracts_sk.provenance.badge") %></h2>
                <% if @contract.imported_at.present? %>
                  <%# Same localized date rule as the identity line. %>
                  <p class="cs-small">
                    <%= t("decidim.contracts_sk.provenance.imported_on") %> <%= format_date(@contract.imported_at) %>
                  </p>
                <% end %>
              </div>
              <% if mirror_stale?(@contract) %>
                <p class="cs-small"><span class="label warning"><%= t("decidim.contracts_sk.provenance.stale") %></span></p>
              <% end %>
              <p class="cs-small"><%= t("decidim.contracts_sk.provenance.note") %></p>
            </div>
          </section>
        <% end %>

        <section>
          <h2 class="h3 decorator"><%= t("decidim.contracts_sk.contracts.show.parties") %></h2>
          <%# Materialized once: the presence check and the iteration share a
              single loaded collection instead of issuing two identical
              queries. One row per party — name and address left, role and
              IČO right — because a four-column table cannot fit a phone and
              a row can. The IČO label reuses the parties form vocabulary. %>
          <% parties = @contract.parties.to_a %>
          <% if parties.any? %>
            <ul class="cs-list">
              <% parties.each do |party| %>
                <li class="cs-party">
                  <div>
                    <p class="cs-party__name"><%= supplier_link_or_name(party, class: "cs-link") %></p>
                    <% if party.address.present? %>
                      <p class="cs-small"><%= party.address %></p>
                    <% end %>
                  </div>
                  <div class="cs-party__side">
                    <span class="label"><%= t("decidim.contracts_sk.contract.party.#{party.role}") %></span>
                    <% if party.ico.present? %>
                      <span><%= t("decidim.contracts_sk.admin.parties.form.ico") %>: <span class="cs-num"><%= party.ico %></span></span>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="cs-empty cs-empty--inline"><%= t("decidim.contracts_sk.contracts.show.parties_empty") %></p>
          <% end %>
        </section>

        <section>
          <h2 class="h3 decorator"><%= t("decidim.contracts_sk.contracts.show.documents") %></h2>
          <%# Only attached documents render: a metadata-only row has neither
              a file to link nor a size to show, so it is skipped rather than
              rendered as a dead entry. Materialized once: the presence check
              and the iteration share a single loaded collection. The
              download link goes through main_app — ActiveStorage's
              `direct :rails_blob` helper lives on the host application's
              route set, not on the isolated engine's, and the request-bound
              main_app proxy supplies the URL context (safe for any mount
              point). The size comes from the synced metadata columns, never
              from the blob service (civora-org/civora-platform#73). %>
          <% documents = @contract.documents.select { |document| document.file.attached? } %>
          <% if documents.any? %>
            <ul class="cs-list">
              <% documents.each do |document| %>
                <li class="cs-doc">
                  <%= contracts_icon(:document) %>
                  <div class="cs-doc__body">
                    <%= link_to document.title, main_app.rails_blob_path(document.file, disposition: :attachment), class: "cs-link" %>
                    <p class="cs-small">(<%= t("decidim.contracts_sk.contract.document.#{document.kind}") %>, <%= number_to_human_size(document.file_size) %>)</p>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="cs-empty cs-empty--inline"><%= t("decidim.contracts_sk.contracts.show.documents_empty") %></p>
          <% end %>
        </section>

        <%# Related links (M01-87, civora-org/civora-platform#87): the
            record's links to platform-level project/result entities,
            resolved LIVE through the config-time link_target_resolver seam
            at render time. Dangling or unresolvable targets are hidden —
            never raise, never leak internals — and the section disappears
            entirely when nothing renderable remains (no empty state on the
            public page). Labels may render as plain text when the resolver
            supplies no URL. %>
        <% renderable_links = @contract.links.filter_map do |link|
             info = Decidim::ContractsSk.resolve_link_target(link)
             [link, info] if info
           end %>
        <% if renderable_links.any? %>
          <section>
            <h2 class="h3 decorator"><%= t("decidim.contracts_sk.contracts.show.links") %></h2>
            <ul class="cs-list">
              <% renderable_links.each do |_link, info| %>
                <li class="cs-plain">
                  <% if info[:url].present? %>
                    <%= link_to info[:label], info[:url], class: "cs-link" %>
                  <% else %>
                    <span class="cs-party__name"><%= info[:label] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <section>
          <h2 class="h3 decorator"><%= t("decidim.contracts_sk.contracts.show.versions") %></h2>
          <%# Public version history (M02-05-B, civora-org/civora-platform#65,
              ADR-006): the record's live fields above ARE the current
              version; the published amendments below are the frozen
              historical ones, newest version first. Drafts are never
              publicly visible — the controller scopes them out (the
              published scope IS the gate, mirroring the record's own
              published-only read). The snapshot fields are labelled with the
              record's own content-field vocabulary, and the publish-time
              value may be nil (a blank field was legal at publish), so
              absent values are skipped rather than rendered empty. The CRZ
              entry stays guarded like the current version's (no blank
              href). to_h normalizes whatever the :json column hands back
              before iterating — the render must never depend on the
              deserialized value's runtime class. %>
          <% if @amendments.any? %>
            <ol class="cs-list">
              <li class="cs-version cs-version--current">
                <p class="cs-version__head"><%= t("decidim.contracts_sk.contracts.show.current_version") %></p>
              </li>
              <% @amendments.each do |amendment| %>
                <%# Each historical version is its own row: a header line
                    (version number and publish date) above the frozen
                    snapshot grid, the same label/value treatment as the
                    facts panel (#80 blank guards, #81 locale helpers). %>
                <li class="cs-version">
                  <p class="cs-version__head">
                    <%= t("decidim.contracts_sk.contracts.show.version_label", version: amendment.version) %>
                    <% if amendment.published_at.present? %>
                      <span>· <%= format_date(amendment.published_at) %></span>
                    <% end %>
                  </p>
                  <dl class="cs-dl">
                    <div class="cs-dl__wide">
                      <dt><%= t("decidim.contracts_sk.contract.summary") %></dt>
                      <dd><%= amendment.summary %></dd>
                    </div>

                    <% amendment.content_snapshot.to_h.each do |field, value| %>
                      <% next if value.blank? %>
                      <% if field == "crz_url" %>
                        <div class="cs-dl__wide">
                          <dt><%= t("decidim.contracts_sk.contract.crz_url") %></dt>
                          <dd><%= link_to value, value %></dd>
                        </div>
                      <% elsif field == "amount" %>
                        <%# The frozen amount renders through the same
                            locale-aware helper as the live fields (#81); the
                            currency renders under its own row, exactly as
                            stored. %>
                        <div>
                          <dt><%= t("decidim.contracts_sk.contract.amount") %></dt>
                          <dd><%= format_amount(value) %></dd>
                        </div>
                      <% elsif %w[signed_on effective_from].include?(field) %>
                        <%# Frozen ISO date strings localize through
                            format_date too (#81, reviewer M-1: one card, one
                            format). Parsing is guarded — a malformed frozen
                            value renders raw, never 500s the public page. %>
                        <% parsed = Date.iso8601(value) rescue nil %>
                        <div>
                          <dt><%= t("decidim.contracts_sk.contract.#{field}") %></dt>
                          <dd><%= parsed ? format_date(parsed) : value %></dd>
                        </div>
                      <% else %>
                        <%# Long free text (title, subject matter) takes the
                            full row; short values sit two to a row. %>
                        <%= tag.div(class: ("cs-dl__wide" if value.to_s.length > 40)) do %>
                          <dt><%= t("decidim.contracts_sk.contract.#{field}") %></dt>
                          <dd><%= value %></dd>
                        <% end %>
                      <% end %>
                    <% end %>
                  </dl>
                </li>
              <% end %>
            </ol>
          <% else %>
            <p class="cs-empty cs-empty--inline"><%= t("decidim.contracts_sk.contracts.show.versions_empty") %></p>
          <% end %>
        </section>
      </div>
    </div>
  </div>
</main>
