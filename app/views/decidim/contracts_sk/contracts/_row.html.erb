<%# One register row of a contract list (catalogue index and supplier page).
    Local: contract. Title and identity on the left; the amount, the figure
    a reader compares down the list, right-aligned in tabular numerals on
    md+ and below the title on narrow screens. %>
<li class="cs-row">
  <div>
    <%= link_to contract.title, contract_path(contract), class: "cs-row__title" %>
    <div class="cs-meta">
      <span><%= contract.reference %></span>
      <%# Locale-aware date rendering (civora-org/civora-platform#81):
          the format string ships with the engine, so no host-app
          locale data is required. %>
      <%# The publication date the catalogue filters and sorts by
          (civora-org/civora-platform#159): "Published in CRZ on: <date>"
          for the real CRZ date (the detail page's punctuation), the bare
          entry date otherwise. format_date takes both a Date and a Time. %>
      <% if publication_date(contract).present? %>
        <span>
          <% if publication_date_from_crz?(contract) %><%= publication_date_label(contract) %>: <% end %>
          <%= format_date(publication_date(contract)) %>
        </span>
      <% end %>
    </div>
    <%# CRZ-mirror provenance (civora-org/civora-platform#88, ADR-002
        rule 1): imported records are labelled externally
        confirmed, with the mirror date — never presented as
        engine-published content. Editorial records render nothing
        extra. The stale indicator is deliberately detail-only to
        keep rows lean. %>
    <% if imported_contract?(contract) %>
      <div class="cs-tags">
        <span class="label">
          <%= t("decidim.contracts_sk.provenance.badge") %>
          <% if contract.imported_at.present? %>
            · <%= format_date(contract.imported_at) %>
          <% end %>
        </span>
      </div>
    <% end %>
  </div>
  <% if contract.amount.present? %>
    <div class="cs-amount"><%= format_amount(contract.amount, contract.currency) %></div>
  <% end %>
</li>
