<%# The public catalogue, a results-first register: a compact header (title and
    the Zoznam | Štatistiky switch on one line), one search with its filter
    chips, then a one-line toolbar (count and EUR total on the left; sort,
    downloads and the alert link on the right) directly above the list.
    The centered single-column container is the one the host layout partial
    (layouts/decidim/shared/layout_center) would emit: the compiled classes
    are used directly so the engine keeps no view-path dependency on the
    host's layout partials. cols-10 (not cols-8): the catalogue is a
    register with a right-aligned amount column, and needs the width.
    Layout styling comes from the engine's own scoped stylesheet (see
    shared/_public_styles for why not Tailwind utilities). %>
<% catalogue_meta_tags(@contracts.current_page) %>
<%= render "decidim/contracts_sk/shared/public_styles" %>
<% query = catalogue_query %>
<%# Feed auto-discovery (civora-org/civora-platform#120): readers pick the
    feed up from the page head (decidim-core's _head partial yields
    :header_snippets). Same filters as the page, no sort; absent for the
    source=crz filter, whose own-records feed would be empty. %>
<% content_for :header_snippets, feed_discovery_link(query) unless query.filters.source == "crz" %>
<main class="layout-1col cols-10">
  <div class="cs-page cs-reg cs-reg--top">
    <header class="cs-top">
      <h1 class="cs-top__title"><%= t("decidim.contracts_sk.contracts.index.title") %></h1>
      <%= render "decidim/contracts_sk/shared/section_switch", current: :catalogue %>
    </header>

    <%= render "decidim/contracts_sk/contracts/filters", query: query %>

    <% if @contracts.any? %>
      <h2 class="cs-sr" id="cs-register-title"><%= t("decidim.contracts_sk.contracts.index.list_heading") %></h2>
      <%= render "decidim/contracts_sk/contracts/toolbar", query: query %>

      <%# The register: one hairline-separated row per contract, as a list. %>
      <ol class="cs-list" aria-labelledby="cs-register-title">
        <% @contracts.each do |contract| %>
          <%= render "decidim/contracts_sk/contracts/row", contract: contract %>
        <% end %>
      </ol>

      <%# Page links from two pages up; every filter key
          (CatalogueQuery::PARAM_KEYS) travels over them. %>
      <% if @contracts.total_pages > 1 %>
        <%= render "decidim/contracts_sk/shared/register_pagination",
                   collection: @contracts, carried_params: query.to_params.symbolize_keys %>
      <% end %>
    <% else %>
      <%# Two distinct empty states: a search that finds nothing is a
          different situation from an empty catalogue — the record exists,
          it just does not match the query. %>
      <% if query.active? %>
        <p class="cs-empty">
          <%= t("decidim.contracts_sk.contracts.index.no_search_results") %>
          <%= link_to t("decidim.contracts_sk.contracts.index.filters.clear"), contracts_path, class: "cs-link" %>
          <%# A search that matches nothing yet is the best time to ask to hear
              when something does (own records only, like the toolbar's link). %>
          <% unless query.filters.source == "crz" %>
            <%= link_to catalogue_follow_path(query), class: "cs-bar__follow" do %>
              <svg class="cs-bar__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5h14v10H3zM3.5 5.5L10 11l6.5-5.5"/></svg>
              <span><%= t("decidim.contracts_sk.contracts.index.toolbar.follow") %></span>
            <% end %>
          <% end %>
        </p>
      <% else %>
        <p class="cs-empty"><%= t("decidim.contracts_sk.contracts.index.empty") %></p>
      <% end %>
    <% end %>
  </div>
</main>
