<%# The centered single-column container the host layout partial
    (layouts/decidim/shared/layout_center, columns: 8) would emit: the
    compiled classes are used directly so the engine keeps no view-path
    dependency on the host's layout partials. %>
<main class="layout-1col cols-8">
  <h1 class="title-decorator"><%= t("decidim.contracts_sk.contracts.index.title") %></h1>

  <% if @contracts.any? %>
    <div class="card__list-list">
      <% @contracts.each do |contract| %>
        <div class="card__list">
          <div class="card__list-content">
            <span class="card__list-title">
              <%= link_to contract.title, contract_path(contract) %>
            </span>
            <div class="card__list-text"><%= contract.reference %></div>
            <div class="card__list-metadata">
              <%# Deterministic ISO rendering on purpose: the engine ships no
                  locale date formats, so I18n.l would depend on host-app data. %>
              <div><%= contract.published_at&.to_date&.to_fs(:db) %></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%# Catalogue pagination (civora-org/civora-platform#86b): the shared
        engine partial, page controls only from two pages up; the catalogue
        has no filters, so nothing is carried over. %>
    <% if @contracts.total_pages > 1 %>
      <%= render "decidim/contracts_sk/shared/pagination",
                 collection: @contracts,
                 filter_keys: [] %>
    <% end %>
  <% else %>
    <p class="text-lg text-gray-2"><%= t("decidim.contracts_sk.contracts.index.empty") %></p>
  <% end %>
</main>
