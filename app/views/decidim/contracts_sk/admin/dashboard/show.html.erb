<%= render "decidim/contracts_sk/shared/admin_styles" %>
<%# Admin home: "What needs doing today". A short, prioritised list of
    ACTIONS for the signed-in person only (Admin::TodayTasks decides what
    is theirs through the permission layer), each one sentence and ONE
    button, grouped by urgency. Decidim admin classes plus the engine's
    .cs-today* rules only: the host stylesheet is compiled at image build
    and silently drops engine-only Tailwind utilities (docs/public-ui.md).
    The overview of all contracts and the latest audit events are one click
    away, collapsed. %>
<% scope = "decidim.contracts_sk.admin.today" %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title"><%= t("#{scope}.title") %></h1>
    <div class="cs-admin-actions">
      <% if can_create_contract? %>
        <%= link_to t("decidim.contracts_sk.admin.contracts.new.title"), new_admin_contract_path,
                    class: "button button__sm button__secondary" %>
      <% end %>
      <%= link_to t("decidim.contracts_sk.admin.dashboard.all_contracts"), admin_contracts_path,
                  class: "button button__sm button__secondary" %>
    </div>
  </div>

  <div class="card-section">
    <p class="cs-today__lead"><%= t("#{scope}.lead", date: format_date(dashboard_today)) %></p>

    <% if today_tasks.empty? %>
      <div class="cs-today__done" id="today-empty">
        <h2 class="cs-today__done-title"><%= t("#{scope}.empty.title") %></h2>
        <p><%= t("#{scope}.empty.body") %></p>
      </div>
    <% else %>
      <% Decidim::ContractsSk::Admin::TodayTasks::GROUPS.each do |group| %>
        <% tasks = today_tasks.by_group(group) %>
        <% next if tasks.empty? %>
        <section class="cs-today__group" aria-labelledby="today-group-<%= group %>">
          <h2 class="cs-today__group-title" id="today-group-<%= group %>"><%= t("#{scope}.groups.#{group}.title") %></h2>
          <p class="cs-today__group-hint"><%= t("#{scope}.groups.#{group}.hint") %></p>
          <ul class="cs-today__list">
            <% tasks.each do |task| %>
              <%= render "task", task: task %>
            <% end %>
          </ul>
          <% if group == :urgent && today_tasks.urgent_total > tasks.size %>
            <p class="cs-today__more">
              <%= link_to t("#{scope}.more_urgent", count: today_tasks.urgent_total - tasks.size),
                          admin_contracts_path(deadline: :unfiled) %>
            </p>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>

  <%# Counts per state: one grouped query, the lifecycle vocabulary in its
      own order (zeros included), each chip a filtered-index link. %>
  <div class="card-section">
    <details class="cs-today__details" id="today-overview">
      <summary><%= t("decidim.contracts_sk.admin.dashboard.counts.title") %></summary>
      <% if total_count.zero? %>
        <p><%= t("decidim.contracts_sk.admin.dashboard.counts.empty") %></p>
      <% else %>
        <div class="cs-admin-chips">
          <%= link_to "#{t("decidim.contracts_sk.admin.dashboard.counts.all")} (#{total_count})",
                      admin_contracts_path, class: "button button__sm button__secondary" %>
          <% state_counts.each do |state, count| %>
            <%= link_to "#{t(state, scope: "decidim.contracts_sk.contract_states")} (#{count})",
                        admin_contracts_path(state: state), class: "button button__sm button__secondary" %>
          <% end %>
        </div>
      <% end %>
    </details>
  </div>

  <% if audit_trail_visible? %>
    <div class="card-section">
      <details class="cs-today__details" id="today-recent-activity">
        <summary id="dashboard-recent-activity-title"><%= t("decidim.contracts_sk.admin.dashboard.recent_activity.title") %></summary>
        <% if recent_events.any? %>
          <%= render "decidim/contracts_sk/admin/audit_events/table", events: recent_events, labelled_by: "dashboard-recent-activity-title" %>
          <p class="cs-admin-more"><%= link_to t("decidim.contracts_sk.admin.dashboard.recent_activity.show_all"),
                         admin_audit_events_path, class: "button button__sm button__secondary" %></p>
        <% else %>
          <p><%= t("decidim.contracts_sk.admin.dashboard.recent_activity.empty") %></p>
        <% end %>
      </details>
    </div>
  <% end %>
</div>
