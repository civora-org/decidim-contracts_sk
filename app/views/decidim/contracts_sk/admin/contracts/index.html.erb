<%= render "decidim/contracts_sk/shared/admin_styles" %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title" id="cs-contracts-title">
      <%= t("decidim.contracts_sk.admin.contracts.index.title") %>
    </h1>
    <%# The admin home ("What needs doing today") and, for editors, the one
        thing they start from: a new contract. Templates, imports and the
        CRZ lookup are rarely used and live in the collapsed tools below. %>
    <div class="cs-admin-actions">
      <% if allowed_to?(:create, :contract) %>
        <%= link_to t("decidim.contracts_sk.admin.contracts.new.title"), new_admin_contract_path,
                    class: "button button__sm button__secondary" %>
      <% end %>
      <%= link_to t("decidim.contracts_sk.admin.dashboard.overview_link"), admin_root_path,
                  class: "button button__sm button__secondary" %>
    </div>
  </div>

  <%# Per-state lifecycle counters (civora-org/civora-platform#93): ONE
      grouped query over the UNFILTERED tenant scope — the chips are the
      honest "3 awaiting review" navigation and deliberately ignore the
      active filter. States derive from ContractLifecycle::STATES, never
      hand-enumerated; zero counts render too (the filter form likewise
      always lists the full vocabulary). Each chip is a GET link setting
      state= while preserving the active source/q filters; the active
      state's chip carries the --active marker class. %>
  <div class="card-section">
    <div class="cs-admin-chips">
      <%= link_to index_counter_label(nil), index_counter_path(nil), class: index_counter_classes(nil),
                  aria: { current: (index_filters.state.nil? ? "true" : nil) } %>
      <% Decidim::ContractsSk::ContractLifecycle::STATES.each do |state| %>
        <%= link_to index_counter_label(state), index_counter_path(state), class: index_counter_classes(state),
                    aria: { current: (index_filters.state == state ? "true" : nil) } %>
      <% end %>
    </div>
  </div>

  <%# Search and filters (civora-org/civora-platform#86b): a GET form, so the
      filter state lives in the URL and survives pagination links. Plain
      Rails tag helpers — never a Decidim FormBuilder field next to a
      standalone label (the builder renders its own label around each
      field); label_tag + select_tag is the safe pairing here. Only the text
      search is always visible; the other filters (and the CRZ deadline
      chips, § 47a OZ, civora-org/civora-platform#124) sit in one collapsed
      block that opens by itself when one of them is in use. %>
  <div class="card-section">
    <%= form_tag admin_contracts_path, method: :get, class: "form form-defaults" do %>
      <div class="row column cs-admin-search">
        <%= label_tag :q, t("decidim.contracts_sk.admin.contracts.index.filters.q") %>
        <%= text_field_tag :q, index_filters.q %>
      </div>
      <% more_open = index_filters.state || index_filters.source || index_filters.deadline || index_filters.submitter || index_filters.missing %>
      <details class="cs-today__details cs-admin-filters"<%= raw(" open") if more_open %>>
        <summary><%= t("decidim.contracts_sk.admin.contracts.index.filters.more") %></summary>
        <%# CRZ publication deadline counters: editorial records NOT CONFIRMED
            AS FILED in CRZ (crz_filed_at empty, #125) that are overdue or due
            within 14 days. Like the state chips they count the UNFILTERED
            tenant scope and link to the deadline= filter while preserving the
            other normalized filters. Aid only, not legal advice (see the hint). %>
        <div class="cs-admin-chips">
          <% %i[due_soon overdue].each do |deadline| %>
            <%= link_to index_deadline_counter_label(deadline), index_deadline_counter_path(deadline),
                        class: index_deadline_counter_classes(deadline),
                        aria: { current: (index_filters.deadline == deadline ? "true" : nil) } %>
          <% end %>
        </div>
        <p class="cs-admin-hint"><em><%= t("decidim.contracts_sk.admin.contracts.deadline.hint") %></em></p>
        <div class="row column">
          <%= label_tag :state, t("decidim.contracts_sk.admin.contracts.index.filters.state") %>
          <%= select_tag :state, options_for_select(index_state_options, selected: index_filters.state) %>
        </div>
        <div class="row column">
          <%= label_tag :source, t("decidim.contracts_sk.admin.contracts.index.filters.source") %>
          <%= select_tag :source, options_for_select(index_source_options, selected: index_filters.source) %>
        </div>
        <div class="row column">
          <%= label_tag :deadline, t("decidim.contracts_sk.admin.contracts.index.filters.deadline") %>
          <%= select_tag :deadline, options_for_select(index_deadline_options, selected: index_filters.deadline) %>
        </div>
        <div class="row column">
          <%= label_tag :submitter, t("decidim.contracts_sk.admin.contracts.index.filters.submitter") %>
          <%= select_tag :submitter, options_for_select(index_submitter_options, selected: index_filters.submitter) %>
        </div>
        <% if index_filters.missing %>
          <%# Set from the admin home's data-quality tasks; carried through so a
              re-filter keeps the list the person came for. %>
          <%= hidden_field_tag :missing, index_filters.missing, id: "missing" %>
          <p class="cs-admin-hint"><%= t("decidim.contracts_sk.admin.contracts.index.filters.missing.#{index_filters.missing}") %></p>
        <% end %>
      </details>
      <div class="row column cs-admin-filter-actions">
        <%= submit_tag t("decidim.contracts_sk.admin.contracts.index.filters.submit"),
                       class: "button button__sm button__secondary" %>
        <%= link_to t("decidim.contracts_sk.admin.contracts.index.filters.clear"),
                    admin_contracts_path,
                    class: "button button__sm button__secondary clear" %>
      </div>
    <% end %>
  </div>

  <%# Rarely used tools, collapsed: templates (civora-org/civora-platform#127,
      editor-only), the spreadsheet import (#129) and the single-record CRZ
      import (ADR-008, #86: a plain POST form with one numeric field — no
      builder label next to a field helper). %>
  <% if allowed_to?(:read, :template) || allowed_to?(:import_file, :contract) || allowed_to?(:import_crz, :contract) %>
    <div class="card-section">
      <details class="cs-today__details cs-admin-tools" id="cs-admin-tools">
        <summary><%= t("decidim.contracts_sk.admin.contracts.index.tools") %></summary>
        <% if allowed_to?(:read, :template) %>
          <p><%= link_to t("decidim.contracts_sk.admin.templates.link"), admin_templates_path,
                         class: "button button__sm button__secondary" %></p>
        <% end %>
        <% if allowed_to?(:import_file, :contract) %>
          <p><%= link_to t("decidim.contracts_sk.admin.contract_imports.entry_link"), admin_new_contract_import_path, class: "button button__sm button__secondary" %></p>
        <% end %>
        <% if allowed_to?(:import_crz, :contract) %>
          <p><%= t("decidim.contracts_sk.admin.contracts.import_crz.description") %></p>
          <%= form_with url: import_crz_admin_contracts_path, method: :post, local: true, html: { class: "form form-defaults" } do %>
            <div class="form__wrapper">
              <%= label_tag :source_id, t("decidim.contracts_sk.admin.contracts.import_crz.label") %>
              <%= text_field_tag :source_id, nil, placeholder: "12345678" %>
            </div>
            <%= submit_tag t("decidim.contracts_sk.admin.contracts.import_crz.submit"),
                           class: "button button__sm button__secondary",
                           data: { disable_with: t("decidim.contracts_sk.admin.contracts.import_crz.submitting") } %>
            <p><em><%= t("decidim.contracts_sk.admin.contracts.import_crz.hint") %></em></p>
          <% end %>
        <% end %>
      </details>
    </div>
  <% end %>

  <% if @contracts.any? %>
    <div class="table-scroll" tabindex="0" role="region" aria-labelledby="cs-contracts-title">
      <table class="table-list cs-rows" aria-labelledby="cs-contracts-title">
        <thead>
          <tr>
            <th scope="col"><%= t("decidim.contracts_sk.contract.title") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.contract.reference_number") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.contract.status") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.admin.contracts.index.headers.crz_deadline") %></th>
            <%= actions_column_header %>
          </tr>
        </thead>
        <tbody>
          <% @contracts.each do |contract| %>
            <tr>
              <td><%= link_to contract.title, admin_contract_path(contract) %></td>
              <td data-label="<%= t("decidim.contracts_sk.contract.reference_number") %>"><%= contract.reference %></td>
              <td data-label="<%= t("decidim.contracts_sk.contract.status") %>"><%= t(contract.state, scope: "decidim.contracts_sk.contract_states") %></td>
              <%# CRZ deadline badge (civora-org/civora-platform#124): empty for filed, mirror and terminal rows. %>
              <td data-label="<%= t("decidim.contracts_sk.admin.contracts.index.headers.crz_deadline") %>"><%= crz_deadline_badge(contract, today: index_today) %></td>
              <td class="table-list__actions">
                <%# ONE visible action per row: open the contract page, where the
                    next step lives. A GET button_to, not a link: see the CRZ
                    filing entry below for why a bare <a> in this table cell can
                    render invisible. Everything else the row used to show is one
                    click away in the collapsed block. %>
                <%= button_to t("decidim.contracts_sk.admin.contracts.index.open"),
                              admin_contract_path(contract),
                              method: :get,
                              class: "button button__sm button__secondary",
                              aria: { label: contract_row_label(t("decidim.contracts_sk.admin.contracts.index.open"), contract) } %>
                <details class="cs-row-more">
                  <summary aria-label="<%= contract_row_label(t("decidim.contracts_sk.admin.contracts.index.more_actions"), contract) %>"><%= t("decidim.contracts_sk.admin.contracts.index.more_actions") %></summary>
                <%# Edit entry (editors, editable states only). %>
                <% if allowed_to?(:update, :contract, contract: contract) %>
                  <%= button_to t("decidim.contracts_sk.admin.contracts.edit.title"),
                                edit_admin_contract_path(contract),
                                method: :get,
                                class: "button button__sm button__secondary",
                                aria: { label: contract_row_label(t("decidim.contracts_sk.admin.contracts.edit.title"), contract) } %>
                <% end %>
                <%# Internal review notes (civora-org/civora-platform#128): the
                    entry for every role holder (a reviewer has no edit page).
                    A GET button_to, not a link: see the CRZ filing entry
                    below for why a bare <a> in this table cell can render
                    invisible. %>
                <% if allowed_to?(:read, :note, contract: contract) %>
                  <%= button_to t("decidim.contracts_sk.admin.notes.link"),
                                admin_contract_notes_path(contract),
                                method: :get,
                                class: "button button__sm button__secondary",
                                aria: { label: contract_row_label(t("decidim.contracts_sk.admin.notes.link"), contract) } %>
                <% end %>
                <%# Derived, never hand-enumerated: only the events the acting role may fire.
                    The judgment edges (return/reject, #90) render the inline decision-reason
                    form instead of a bare button — the command requires the reason. %>
                <% transition_events_for(contract).each do |event| %>
                  <% if reason_event?(event) %>
                    <%= render "review_decision_form", contract: contract, event: event %>
                  <% else %>
                    <%= button_to t("decidim.contracts_sk.admin.contracts.transition.#{event}", default: event.to_s.humanize),
                                  public_send(:"#{event}_admin_contract_path", contract),
                                  method: :post,
                                  class: "button button__sm button__secondary",
                                  aria: { label: contract_row_label(t("decidim.contracts_sk.admin.contracts.transition.#{event}", default: event.to_s.humanize), contract) },
                                  data: { confirm: t("decidim.contracts_sk.admin.contracts.transition.confirm.#{event}") } %>
                  <% end %>
                <% end %>
                <%# ADR-007 surface on the index (civora-org/civora-platform#91):
                    for a confirmable, unstamped record the acting editor can
                    confirm the redaction checklist straight from the row —
                    collapsed by default so it stays compact. Permission-gated
                    exactly like the transition buttons above: :confirm_redaction
                    carries the editor role plus the confirmable window
                    (editable states + approved); the stamp check keeps
                    already-stamped records free of a second form (their
                    confirmation line lives on the edit page). %>
                <% if allowed_to?(:confirm_redaction, :contract, contract: contract) && contract.redaction_confirmed_at.blank? %>
                  <%= render "redaction_confirmation", contract: contract, collapsed: true %>
                <% end %>
                <%# CRZ filing confirmation entry (civora-org/civora-platform#125):
                    shown only when the acting editor may confirm (editor, a
                    published, unfiled editorial record — the :confirm_crz_filing
                    permission). The flow itself lives on its own page. %>
                <% if allowed_to?(:confirm_crz_filing, :contract, contract: contract) %>
                  <%# A GET button_to, not a link styled as a button: decidim-admin's
                      `.table-list td a` colour rule (compiled with its `:not(.button)`
                      exclusion mangled) paints any <a> in a table cell the secondary
                      colour — on a secondary-background button that is invisible text.
                      A <button> in a form, like the sibling actions, is untouched. %>
                  <%= button_to t("decidim.contracts_sk.admin.contracts.crz_filing.link"),
                                crz_filing_admin_contract_path(contract),
                                method: :get,
                                class: "button button__sm button__secondary",
                                aria: { label: contract_row_label(t("decidim.contracts_sk.admin.contracts.crz_filing.link"), contract) } %>
                <% end %>
                <%# Reviewer decision on the row (civora-org/civora-platform#90):
                    a record sitting in a decision state with a captured
                    reason shows it collapsed right here — for a rejected
                    record this read-only card is the only place its reason
                    is reachable (terminal states render no transition
                    controls, and the edit page stays permission-locked).
                    Gated on reason presence only: any admin who can see
                    the row may read it — the same audience as the index —
                    so unlike the redaction card above there is deliberately
                    no permission check on a read. %>
                <% if contract.review_reason.present? && Decidim::ContractsSk::ContractLifecycle::DECISION_STATES.include?(contract.state&.to_sym) %>
                  <%= render "review_decision", contract: contract, collapsed: true %>
                <% end %>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Page controls render only from two pages up (civora-org/
        civora-platform#86b); the partial carries exactly the filter keys
        over — never raw request params. %>
    <% if @contracts.total_pages > 1 %>
      <%= render "decidim/contracts_sk/shared/pagination",
                 collection: @contracts,
                 filter_keys: %i[state source q deadline submitter missing] %>
    <% end %>
  <% else %>
    <div class="card-section">
      <% if index_filters_active? %>
        <%# Filtered no-matches (civora-org/civora-platform#93): distinct
            from the true-empty state below, gated on the NORMALIZED
            filters — a garbage param falls back to the default view and
            gets the true-empty wording. The clear link points at the bare
            index path. %>
        <h2><%= t("decidim.contracts_sk.admin.contracts.index.no_matches.heading") %></h2>
        <p><%= t("decidim.contracts_sk.admin.contracts.index.no_matches.body") %></p>
        <p><%= link_to t("decidim.contracts_sk.admin.contracts.index.no_matches.clear"),
                       admin_contracts_path,
                       class: "button button__sm button__secondary clear" %></p>
      <% else %>
        <p><%= t("decidim.contracts_sk.admin.contracts.index.empty") %></p>
      <% end %>
    </div>
  <% end %>
</div>
