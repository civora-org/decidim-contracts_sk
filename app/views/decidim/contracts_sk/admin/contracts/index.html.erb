<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("decidim.contracts_sk.admin.contracts.index.title") %>
    </h1>
  </div>

  <% if allowed_to?(:create, :contract) %>
    <div class="card-section">
      <p><%= link_to t("decidim.contracts_sk.admin.contracts.new.title"), new_admin_contract_path, class: "button button__sm button__secondary" %></p>
    </div>
  <% end %>

  <%# CRZ single-record import (ADR-008, civora-org/civora-platform#86):
      a plain POST form with one numeric field — no builder label next to
      a field helper (the FormBuilder wraps fields in labels itself). %>
  <% if allowed_to?(:import_crz, :contract) %>
    <div class="card-section">
      <p><%= t("decidim.contracts_sk.admin.contracts.import_crz.description") %></p>
      <%= form_with url: import_crz_admin_contracts_path, method: :post, local: true do %>
        <div class="row column">
          <%= label_tag :source_id, t("decidim.contracts_sk.admin.contracts.import_crz.label") %>
          <%= text_field_tag :source_id, nil, placeholder: "12345678" %>
        </div>
        <%= submit_tag t("decidim.contracts_sk.admin.contracts.import_crz.submit"),
                       class: "button button__sm button__secondary",
                       data: { disable_with: t("decidim.contracts_sk.admin.contracts.import_crz.submitting") } %>
        <p><em><%= t("decidim.contracts_sk.admin.contracts.import_crz.hint") %></em></p>
      <% end %>
    </div>
  <% end %>

  <%# Index filters (civora-org/civora-platform#86b): a GET form, so the
      filter state lives in the URL and survives pagination links. Plain
      Rails tag helpers — never a Decidim FormBuilder field next to a
      standalone label (the builder renders its own label around each
      field); label_tag + select_tag is the safe pairing here. %>
  <div class="card-section">
    <%= form_tag admin_contracts_path, method: :get do %>
      <div class="row column">
        <%= label_tag :state, t("decidim.contracts_sk.admin.contracts.index.filters.state") %>
        <%= select_tag :state, options_for_select(index_state_options, selected: index_filters.state) %>
      </div>
      <div class="row column">
        <%= label_tag :source, t("decidim.contracts_sk.admin.contracts.index.filters.source") %>
        <%= select_tag :source, options_for_select(index_source_options, selected: index_filters.source) %>
      </div>
      <div class="row column">
        <%= label_tag :q, t("decidim.contracts_sk.admin.contracts.index.filters.q") %>
        <%= text_field_tag :q, index_filters.q %>
      </div>
      <div class="row column">
        <%= submit_tag t("decidim.contracts_sk.admin.contracts.index.filters.submit"),
                       class: "button button__sm button__secondary" %>
        <%= link_to t("decidim.contracts_sk.admin.contracts.index.filters.clear"),
                    admin_contracts_path,
                    class: "button button__sm button__secondary clear" %>
      </div>
    <% end %>
  </div>

  <% if @contracts.any? %>
    <div class="table-scroll">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t("decidim.contracts_sk.contract.title") %></th>
            <th><%= t("decidim.contracts_sk.contract.reference_number") %></th>
            <th><%= t("decidim.contracts_sk.contract.status") %></th>
            <th><%= t("decidim.contracts_sk.admin.contracts.edit.title") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @contracts.each do |contract| %>
            <tr>
              <td><%= contract.title %></td>
              <td><%= contract.reference %></td>
              <td><%= t(contract.state, scope: "decidim.contracts_sk.contract_states") %></td>
              <td><%= link_to t("decidim.contracts_sk.admin.contracts.edit.title"), edit_admin_contract_path(contract) %></td>
              <td class="table-list__actions">
                <%# Derived, never hand-enumerated: only the events the acting role may fire. %>
                <% transition_events_for(contract).each do |event| %>
                  <%= button_to t("decidim.contracts_sk.admin.contracts.transition.#{event}", default: event.to_s.humanize),
                                public_send(:"#{event}_admin_contract_path", contract),
                                method: :post,
                                class: "button button__sm button__secondary",
                                data: { confirm: t("decidim.contracts_sk.admin.contracts.transition.confirm.#{event}") } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Page controls render only from two pages up (civora-org/
        civora-platform#86b); the partial carries exactly the filter keys
        over — never raw request params. %>
    <% if @contracts.total_pages > 1 %>
      <%= render "decidim/contracts_sk/shared/pagination",
                 collection: @contracts,
                 filter_keys: %i[state source q] %>
    <% end %>
  <% else %>
    <div class="card-section">
      <p><%= t("decidim.contracts_sk.admin.contracts.index.empty") %></p>
    </div>
  <% end %>
</div>
