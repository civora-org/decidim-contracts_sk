<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("decidim.contracts_sk.admin.contracts.edit.title") %>
  </h1>
</div>

<%# CRZ publication deadline line (§ 47a OZ, civora-org/civora-platform#124):
    read from the PERSISTED record — a failed update re-renders this page
    with the submitted form values, which must never move the deadline.
    Empty for filed, mirror and terminal records. Aid only, not legal advice. %>
<% deadline_line = crz_deadline_line(@contract) %>
<% if deadline_line %>
  <p><strong><%= deadline_line %></strong><br><em><%= t("decidim.contracts_sk.admin.contracts.deadline.hint") %></em></p>
<% end %>

<p><%= link_to t("decidim.contracts_sk.admin.parties.index.title"), admin_contract_parties_path(@contract) %></p>

<p><%= link_to t("decidim.contracts_sk.admin.amendments.index.title"), admin_contract_amendments_path(@contract) %></p>

<%# Read-only audit-trail viewer (civora-org/civora-platform#92): the same
    hub-link pattern as the two siblings above — the link text is the
    target page's index title, pre-filtered to this record through the
    ?contract_id= GET param (visible to every engine role: the viewer's
    :read gate is role-any, the same rule as this page's own index). %>
<p><%= link_to t("decidim.contracts_sk.admin.audit_events.index.title"), admin_audit_events_path(contract_id: @contract) %></p>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= render "form", url: admin_contract_path(@contract), method: :patch, submit_label: t("decidim.contracts_sk.admin.contracts.edit.title") %>
  </div>
</div>

<%# ADR-007 privacy-redaction confirmation gate (civora-org/civora-platform
    #91): the hard precondition of the publish transition, confirmed inline
    on the edit page — the shared card (checklist + required checkbox + one
    POST, no new page and no JS; the repo's no-nested-form-JS doctrine).
    Once the stamp is present the checkbox form is replaced by a small
    confirmation line; the form is permission-gated exactly like the page's
    other writes. The stamp line itself is historical record and renders
    regardless of role. The admin index row carries the same confirmation as
    a collapsed card through the same partial. %>
<% if @contract.redaction_confirmed_at.present? || allowed_to?(:confirm_redaction, :contract, contract: @contract) %>
  <%= render "redaction_confirmation", contract: @contract %>
<% end %>

<%# Reviewer decision banner (civora-org/civora-platform#90): when the
    record sits in a decision state (returned/rejected) and carries the
    reviewer's judgment text, the reason — with the decision title and
    timestamp — shows here, the editor's answer to "why was this returned?".
    Like the redaction stamp line above it is historical record: it renders
    regardless of role (a returned record is editable, so its editor is the
    audience), and it disappears once the record is resubmitted (submit
    clears both columns). A returned/rejected record without a reason can
    only predate #90 — the command refuses reason-less judgments — so the
    banner stays hidden there rather than rendering an empty frame.
    The admin index row carries the same decision as a collapsed read-only
    card through the same partial (there it is a rejected record's only
    reachable surface for its reason). %>
<% if @contract.review_reason.present? && Decidim::ContractsSk::ContractLifecycle::DECISION_STATES.include?(@contract.state&.to_sym) %>
  <%= render "review_decision", contract: @contract %>
<% end %>

<%# Per-contract document management (civora-org/civora-platform#73): the
    route set has no document index, so the contract's edit page is the
    hub — it lists the documents and carries the attach/replace/remove
    controls, permission-gated exactly like the pages themselves. %>
<div class="card">
  <div class="card-divider">
    <h2 class="card-title" id="cs-documents-title">
      <%= t("decidim.contracts_sk.admin.documents.index.title") %>
    </h2>
  </div>

  <% if allowed_to?(:create, :document, contract: @contract) %>
    <div class="card-section">
      <p><%= link_to t("decidim.contracts_sk.admin.documents.new.title"), new_admin_contract_document_path(@contract), class: "button button__sm button__secondary" %></p>
    </div>
  <% end %>

  <% if @contract.documents.any? %>
    <div class="table-scroll">
      <table class="table-list" aria-labelledby="cs-documents-title">
        <thead>
          <tr>
            <th scope="col"><%= t("decidim.contracts_sk.admin.documents.form.title") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.admin.documents.form.kind") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.admin.documents.form.current_file") %></th>
            <%= actions_column_header %>
          </tr>
        </thead>
        <tbody>
          <% @contract.documents.order(:id).each do |document| %>
            <tr>
              <td><%= document.title %></td>
              <td><%= t("decidim.contracts_sk.admin.documents.kinds.#{document.kind}") %></td>
              <td><%= document.file_name %></td>
              <td class="table-list__actions">
                <% if allowed_to?(:update, :document, contract: @contract) %>
                  <%= link_to t("decidim.contracts_sk.admin.documents.edit.title"),
                              edit_admin_contract_document_path(@contract, document),
                              class: "button button__sm button__secondary" %>
                <% end %>
                <% if allowed_to?(:destroy, :document, contract: @contract) %>
                  <%= button_to t("decidim.contracts_sk.admin.documents.destroy.link"),
                                admin_contract_document_path(@contract, document),
                                method: :delete,
                                class: "button button__sm button__secondary alert",
                                data: { confirm: t("decidim.contracts_sk.admin.documents.destroy.confirm") } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-section">
      <p><%= t("decidim.contracts_sk.admin.documents.index.empty") %></p>
    </div>
  <% end %>
</div>

<%# Per-contract project/result link management (M01-87,
    civora-org/civora-platform#87): the route set has no link index, so the
    contract's edit page is the hub — it lists the links and carries the
    remove controls, permission-gated exactly like the pages themselves.
    A link whose target no longer resolves (dangling polymorphic row or an
    unresolvable type) renders the localized dangling flag so editors can
    clean it up. The add form is plain (no JS picker): a target-type select
    built from the config-time whitelist and a target-id text field. When
    the host has not configured a supported-type vocabulary, the form stays
    hidden — a standalone engine cannot link anything, by design. %>
<div class="card">
  <div class="card-divider">
    <h2 class="card-title" id="cs-links-title">
      <%= t("decidim.contracts_sk.admin.links.index.title") %>
    </h2>
  </div>

  <% if allowed_to?(:create, :link, contract: @contract) && Decidim::ContractsSk.supported_link_target_types.any? %>
    <div class="card-section">
      <%= form_with url: admin_contract_links_path(@contract), method: :post, html: { class: "form form-defaults" } do |form| %>
        <div class="form__wrapper">
          <% type_options = Decidim::ContractsSk.supported_link_target_types.map { |type| [type, type] } %>
          <div class="row column">
            <%= form.select :target_type, type_options,
                            { label: t("decidim.contracts_sk.admin.links.form.target_type"),
                              prompt: true },
                            id: "link_target_type", name: "link[target_type]" %>
          </div>
          <div class="row column">
            <%= form.text_field :target_id,
                                label: t("decidim.contracts_sk.admin.links.form.target_id"),
                                label_options: { for: "link_target_id" },
                                id: "link_target_id", name: "link[target_id]" %>
          </div>
          <%= form.submit t("decidim.contracts_sk.admin.links.form.submit"),
                          class: "button button__sm button__secondary" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Single scoped relation for both the presence check and the table —
      one assignment, one ordering, no divergent re-loads. %>
  <% links = @contract.links.order(:id) %>
  <% if links.any? %>
    <div class="table-scroll">
      <table class="table-list" aria-labelledby="cs-links-title">
        <thead>
          <tr>
            <th scope="col"><%= t("decidim.contracts_sk.admin.links.form.target_type") %></th>
            <th scope="col"><%= t("decidim.contracts_sk.admin.links.form.target_id") %></th>
            <%= actions_column_header %>
          </tr>
        </thead>
        <tbody>
          <% links.each do |link| %>
            <% resolved = Decidim::ContractsSk.resolve_link_target(link) %>
            <tr>
              <td><%= link.target_type %></td>
              <td>
                <% if resolved %>
                  <% if resolved[:url].present? %>
                    <%= link_to resolved[:label], resolved[:url] %>
                  <% else %>
                    <%= resolved[:label] %>
                  <% end %>
                <% else %>
                  <%# Dangling or unresolvable target: flagged for cleanup,
                      never silently rendered as a working link. %>
                  <span class="text-warning"><%= t("decidim.contracts_sk.admin.links.index.dangling") %></span>
                <% end %>
              </td>
              <td class="table-list__actions">
                <% if allowed_to?(:destroy, :link, contract: @contract) %>
                  <%= button_to t("decidim.contracts_sk.admin.links.destroy.link"),
                                admin_contract_link_path(@contract, link),
                                method: :delete,
                                class: "button button__sm button__secondary alert",
                                data: { confirm: t("decidim.contracts_sk.admin.links.destroy.confirm") } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-section">
      <p><%= t("decidim.contracts_sk.admin.links.index.empty") %></p>
    </div>
  <% end %>
</div>

<%# Internal review notes panel (civora-org/civora-platform#128): the private
    thread role holders keep on the record, never public. The same thread
    partial as the dedicated notes page (the entry for roles that cannot
    edit); posting lands on that page. Gated by the :note read permission
    like the page itself. %>
<% if allowed_to?(:read, :note, contract: @contract) %>
  <div class="card">
    <div class="card-divider">
      <h2 class="card-title">
        <%= t("decidim.contracts_sk.admin.notes.index.title") %>
      </h2>
    </div>

    <%= render "decidim/contracts_sk/admin/notes/thread",
               contract: @contract,
               notes: @contract.notes.includes(:author).order(:id),
               form: Decidim::ContractsSk::Admin::NoteForm.new %>
  </div>
<% end %>

<%# Manual CRZ-handoff export (M02-05-C, civora-org/civora-platform#74):
    a generated, always-regenerable handoff aid for the clerical CRZ
    record (ADR-002) — labelled on the page as an aid, never a legal
    publication. The gates are split to mirror the controller: the
    download link follows its own :download_crz_handoff permission
    (editor on ANY lifecycle state), while generate/regenerate follow
    :update (editor on an editable record) like the page's other writes. %>
<div class="card">
  <div class="card-divider">
    <h2 class="card-title">
      <%= t("decidim.contracts_sk.admin.crz_handoff.title") %>
    </h2>
  </div>

  <div class="card-section">
    <p><%= t("decidim.contracts_sk.admin.crz_handoff.disclaimer") %></p>

    <% if allowed_to?(:download_crz_handoff, :contract, contract: @contract) && @crz_handoff_document&.file&.attached? %>
      <p><%= link_to t("decidim.contracts_sk.admin.crz_handoff.download"),
                     download_crz_handoff_admin_contract_path(@contract),
                     class: "button button__sm button__secondary" %></p>
    <% end %>

    <% if allowed_to?(:update, :contract, contract: @contract) %>
      <% if @crz_handoff_document&.file&.attached? %>
        <%= button_to t("decidim.contracts_sk.admin.crz_handoff.replace"),
                      generate_crz_handoff_admin_contract_path(@contract),
                      method: :post,
                      class: "button button__sm button__secondary" %>
      <% else %>
        <%= button_to t("decidim.contracts_sk.admin.crz_handoff.generate"),
                      generate_crz_handoff_admin_contract_path(@contract),
                      method: :post,
                      class: "button button__sm button__secondary" %>
      <% end %>
    <% end %>
  </div>
</div>
