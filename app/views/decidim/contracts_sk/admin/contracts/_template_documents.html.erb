<%# The files generated from a contract template (civora-org/civora-platform
    #211) as file tiles: the internal Word and PDF, and the publication PDF
    (marked "personal data hidden"), each one link; plus the way back into the
    entered values to generate again. Admin only; the public pages never link
    these files. Shown only for a contract made from a template. Decidim
    classes plus .cs-* engine rules. %>
<% scope = "decidim.contracts_sk.admin.template_entries" %>
<% if @template_entry %>
  <section class="cs-panel" id="cs-template-documents" aria-labelledby="cs-documents-title">
    <div class="cs-panel__head">
      <h2 class="cs-panel__title" id="cs-documents-title"><%= t("#{scope}.documents.heading") %></h2>
      <% if allowed_to?(:update, :contract, contract: @contract) %>
        <%= link_to t("#{scope}.documents.regenerate"), edit_admin_contract_template_entry_path(@contract),
                    class: "button button__sm button__secondary cs-admin-choice--idle" %>
      <% end %>
    </div>
    <p class="cs-show__ref"><%= t("#{scope}.documents.number", number: @template_entry.internal_number) %></p>
    <% if @generated_documents.any? %>
      <ul class="cs-tiles">
        <% @generated_documents.each do |document| %>
          <li class="cs-tiles__item">
            <%= link_to admin_contract_generated_document_path(@contract, document), class: "cs-tile" do %>
              <span class="cs-tile__icon" aria-hidden="true"><%= contracts_icon(:document) %></span>
              <span class="cs-tile__label"><%= t("#{scope}.documents.#{document.variant}_#{document.file_format}") %></span>
              <% if document.variant.to_s == "publication" %>
                <span class="cs-tile__badge"><%= contracts_icon(:lock) %> <%= t("decidim.contracts_sk.admin.show.redacted_badge") %></span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="cs-admin-template-note"><%= t("#{scope}.documents.internal_note") %></p>
      <p class="cs-admin-template-note"><%= t("#{scope}.documents.publication_note") %></p>
      <% if @template_entry.last_generated_at %>
        <p class="cs-admin-template-note"><%= t("#{scope}.documents.generated_on", at: format_datetime(@template_entry.last_generated_at)) %></p>
      <% end %>
    <% end %>
    <% if allowed_to?(:update, :contract, contract: @contract) %>
      <p class="cs-admin-template-note"><%= t("#{scope}.documents.regenerate_hint") %></p>
    <% end %>
  </section>
<% end %>
