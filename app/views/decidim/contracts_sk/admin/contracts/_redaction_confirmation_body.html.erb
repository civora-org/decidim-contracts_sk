<%# Shared ADR-007 privacy-redaction confirmation body (civora-org/
    civora-platform#91), rendered by the _redaction_confirmation wrapper on
    both admin surfaces (edit page card, index row) so the checklist +
    checkbox markup cannot drift apart. While unstamped: the localized
    checklist and the required checkbox posting to confirm_redaction — one
    plain form_with, no JS (the repo's no-nested-form-JS doctrine); the
    affirmation is consumed server-side, the HTML required attribute is a
    UX aid. Once stamped: the historical confirmation line replaces the
    form (index callers never reach this branch — they render only for
    unstamped records). Locals:
      contract - the record to stamp; the checkbox id is derived per record
                 (the index can show several confirmable rows on one page),
                 while the name stays the server-side contract. %>
<% if contract.redaction_confirmed_at.present? %>
  <p><%= t("decidim.contracts_sk.admin.contracts.confirm_redaction.confirmed_on", confirmed_at: contract.redaction_confirmed_at.to_date.to_fs(:db)) %></p>
<% else %>
  <p><%= t("decidim.contracts_sk.admin.contracts.confirm_redaction.description") %></p>
  <ul>
    <% %i[names_addresses bank_details amounts document_content].each do |item| %>
      <li><%= t("decidim.contracts_sk.admin.contracts.confirm_redaction.checklist.#{item}") %></li>
    <% end %>
  </ul>
  <% field_id = "redaction_confirmed_#{contract.id}" %>
  <%= form_with url: confirm_redaction_admin_contract_path(contract), method: :post, html: { class: "form form-defaults" } do |form| %>
    <div class="form__wrapper">
      <%= form.check_box :redaction_confirmed,
                         label: t("decidim.contracts_sk.admin.contracts.confirm_redaction.checkbox_label"),
                         label_options: { for: field_id },
                         id: field_id, name: "redaction_confirmed",
                         required: true %>
      <%= form.submit t("decidim.contracts_sk.admin.contracts.confirm_redaction.submit"),
                      class: "button button__sm button__secondary" %>
    </div>
  <% end %>
<% end %>
