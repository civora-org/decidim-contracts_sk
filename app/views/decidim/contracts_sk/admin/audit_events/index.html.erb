<%= render "decidim/contracts_sk/shared/admin_styles" %>
<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title" id="cs-audit-title">
      <%= t("decidim.contracts_sk.admin.audit_events.index.title") %>
    </h1>
    <%# Admin overview (civora-org/civora-platform#126). %>
    <div class="cs-admin-actions">
      <%= link_to t("decidim.contracts_sk.admin.dashboard.overview_link"), admin_root_path,
                  class: "button button__sm button__secondary" %>
    </div>
  </div>

  <%# Contract-scoped mode (civora-org/civora-platform#92): the banner
      names the filtered contract and links back to the unfiltered trail. %>
  <% if @contract %>
    <div class="card-section">
      <p>
        <strong><%= t("decidim.contracts_sk.admin.audit_events.filter_banner", title: @contract.title) %></strong>
        <%= link_to t("decidim.contracts_sk.admin.audit_events.back_to_all"),
                    admin_audit_events_path,
                    class: "button button__sm button__secondary clear" %>
      </p>
    </div>
  <% end %>

  <% if @audit_events.any? %>
    <%= render "decidim/contracts_sk/admin/audit_events/table", events: @audit_events %>

    <%# Page controls render only from two pages up; the partial carries
        exactly the filter keys over — never raw request params. %>
    <% if @audit_events.total_pages > 1 %>
      <%= render "decidim/contracts_sk/shared/pagination",
                 collection: @audit_events,
                 filter_keys: %i[contract_id] %>
    <% end %>
  <% else %>
    <div class="card-section">
      <p><%= t("decidim.contracts_sk.admin.audit_events.index.empty") %></p>
    </div>
  <% end %>
</div>
