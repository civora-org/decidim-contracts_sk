<%# url:, method: and submit_label: come from the caller (new / edit); only
    the party's content fields are rendered — the parent contract is never
    form-writable (civora-org/civora-platform#76). The role options are
    derived from the model's frozen ROLES vocabulary, never hand-enumerated,
    with localized labels. %>
<%= form_with url: url, method: method, html: { class: "form form-defaults" } do |form| %>
  <div class="card">
    <div class="card-section">
      <div class="form__wrapper">
        <% if @form.errors.any? %>
          <div class="flash alert">
            <ul>
              <% @form.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% role_options = Decidim::ContractsSk::Party::ROLES.map do |role|
             [t("decidim.contracts_sk.admin.parties.roles.#{role}"), role]
           end %>

        <div class="row column">
          <%= form.select :role, role_options, { selected: @form.role, label: t("decidim.contracts_sk.admin.parties.form.role"), label_options: { for: "party_role" } }, id: "party_role", name: "party[role]" %>
        </div>

        <div class="row column">
          <%= form.text_field :name, label: t("decidim.contracts_sk.admin.parties.form.name"), label_options: { for: "party_name" }, id: "party_name", name: "party[name]", value: @form.name %>
        </div>

        <div class="row column">
          <%= form.text_field :ico, label: t("decidim.contracts_sk.admin.parties.form.ico"), label_options: { for: "party_ico" }, id: "party_ico", name: "party[ico]", value: @form.ico %>
        </div>

        <div class="row column">
          <%= form.text_field :address, label: t("decidim.contracts_sk.admin.parties.form.address"), label_options: { for: "party_address" }, id: "party_address", name: "party[address]", value: @form.address %>
        </div>
      </div>
    </div>
  </div>

  <div class="item__edit-sticky">
    <div class="item__edit-sticky-container">
      <%= form.submit submit_label, class: "button button__sm button__secondary" %>
    </div>
  </div>
<% end %>
