<%= render "decidim/contracts_sk/shared/admin_styles" %>
<% scope = "decidim.contracts_sk.admin.template_entries" %>
<div class="item_show__header">
  <h1 class="item_show__header-title"><%= t("#{scope}.new.title") %></h1>
</div>

<p><%= link_to t("#{scope}.new.back"), admin_contract_templates_path %></p>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= render "form", url: admin_contract_template_entries_path(@template), method: :post,
                       submit_label: t("#{scope}.new.submit") %>
  </div>
</div>
