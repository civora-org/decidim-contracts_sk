<%= render "decidim/contracts_sk/shared/admin_styles" %>
<% scope = "decidim.contracts_sk.admin.template_entries" %>
<div class="item_show__header">
  <h1 class="item_show__header-title"><%= t("#{scope}.index.title") %></h1>
</div>

<p><%= link_to t("decidim.contracts_sk.admin.contracts.back_to_index"), admin_contracts_path, class: "button button__sm button__secondary cs-admin-choice--idle" %></p>

<%# The organization's active contract templates: pick one, then fill its
    form once. Nothing is created by this page. %>
<div class="card">
  <div class="card-section">
    <% if @templates.empty? %>
      <p><strong><%= t("#{scope}.index.empty") %></strong></p>
      <p class="cs-admin-template-note"><%= t("#{scope}.index.empty_hint") %></p>
    <% else %>
      <p class="cs-admin-template-note"><%= t("#{scope}.index.lead") %></p>
      <table class="table-list cs-admin-templates">
        <caption class="cs-admin-sr-only"><%= t("#{scope}.index.title") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("#{scope}.index.headers.name") %></th>
            <th scope="col"><%= t("#{scope}.index.headers.fields") %></th>
            <th scope="col"><span class="cs-admin-sr-only"><%= t("#{scope}.index.headers.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @templates.each do |template| %>
            <% count = Decidim::ContractsSk::Templates::TemplateFields.input_fields(template.fields.to_a).size %>
            <tr>
              <th scope="row" class="cs-admin-template-name"><%= template.name %></th>
              <td class="cs-admin-template-ico"><%= t("#{scope}.index.field_count", count: count) %></td>
              <td class="table-list__actions">
                <div>
                  <%= link_to t("#{scope}.index.use"), admin_new_contract_template_entry_path(template),
                              class: "button button__sm button__secondary",
                              "aria-label": t("#{scope}.index.use_named", name: template.name) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
