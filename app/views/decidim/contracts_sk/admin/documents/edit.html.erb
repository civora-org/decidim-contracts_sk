<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("decidim.contracts_sk.admin.documents.edit.title") %>
  </h1>
</div>

<p><%= link_to t("decidim.contracts_sk.admin.documents.back_to_contract"), edit_admin_contract_path(@contract) %></p>

<%# The record's content fields are context, not inputs: a replace swaps
    the file only (civora-org/civora-platform#73), so title/kind and the
    current file render read-only. Same dl treatment as the public detail
    page — classes on the dl structure, no styled component in core. %>
<div class="card">
  <div class="card-section">
    <dl class="grid grid-cols-1 gap-x-8 gap-y-3 md:grid-cols-2">
      <dt class="text-sm text-gray-2"><%= t("decidim.contracts_sk.admin.documents.form.title") %></dt>
      <dd class="text-md text-black mt-0"><%= @document.title %></dd>

      <dt class="text-sm text-gray-2"><%= t("decidim.contracts_sk.admin.documents.form.kind") %></dt>
      <dd class="text-md text-black mt-0"><%= t("decidim.contracts_sk.admin.documents.kinds.#{@document.kind}") %></dd>

      <dt class="text-sm text-gray-2"><%= t("decidim.contracts_sk.admin.documents.form.current_file") %></dt>
      <dd class="text-md text-black mt-0"><%= @document.file_name %></dd>
    </dl>
  </div>
</div>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <%= render "form", url: admin_contract_document_path(@contract, @document), method: :patch, submit_label: t("decidim.contracts_sk.admin.documents.edit.title") %>
  </div>
</div>
