<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t("decidim.contracts_sk.admin.documents.new.title") %>
  </h1>
</div>

<p><%= link_to t("decidim.contracts_sk.admin.documents.back_to_contract"), edit_admin_contract_path(@contract) %></p>

<div class="item__edit item__edit-1col">
