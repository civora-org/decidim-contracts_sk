<%# url:, method:, submit_label: and details: come from the caller (new /
    edit). The details flag shows the title/kind inputs on the attach page;
    the replace page renders the file input only — its form's title/kind
    mirror the persisted record (a replace swaps the file,
    civora-org/civora-platform#73). The kind options are derived from the
    form's EDITOR_KINDS vocabulary, never hand-enumerated, with localized
    labels. The form is multipart: the file travels with the request. %>
<%= form_with model: @form, url: url, method: method, html: { multipart: true, class: "form form-defaults" } do |form| %>
  <div class="card">
    <div class="card-section">
      <div class="form__wrapper">
        <% if @form.errors.any? %>
          <div class="flash alert">
            <ul role="alert" tabindex="-1" autofocus>
              <% @form.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if defined?(details) && details %>
          <div class="row column">
            <%= form.text_field :title, label: t("decidim.contracts_sk.admin.documents.form.title"), label_options: { for: "document_title" }, id: "document_title", name: "document[title]", value: @form.title %>
          </div>

          <%# The options come from the form's EDITOR_KINDS vocabulary (the
              model's KINDS minus the generated handoff artifact's kind,
              civora-org/civora-platform#74), never hand-enumerated, with
              localized labels. %>
          <% kind_options = Decidim::ContractsSk::Admin::DocumentForm::EDITOR_KINDS.map do |kind|
               [t("decidim.contracts_sk.admin.documents.kinds.#{kind}"), kind]
             end %>

          <div class="row column">
            <%= form.select :kind, kind_options, { selected: @form.kind, label: t("decidim.contracts_sk.admin.documents.form.kind"), label_options: { for: "document_kind" } }, id: "document_kind", name: "document[kind]" %>
          </div>
        <% end %>

        <div class="row column">
          <%# The file is presence-validated on the form, so it carries the
              required attribute on both the attach and the replace page
              (civora-org/civora-platform#78). %>
          <%= form.file_field :file, label: t("decidim.contracts_sk.admin.documents.form.file"), label_options: { for: "document_file" }, id: "document_file", name: "document[file]", required: true %>
        </div>
      </div>
    </div>
  </div>

  <div class="item__edit-sticky">
    <div class="item__edit-sticky-container">
      <%= form.submit submit_label, class: "button button__sm button__secondary" %>
    </div>
  </div>
<% end %>
