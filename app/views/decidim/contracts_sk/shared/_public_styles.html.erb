<%# Engine-owned styles for the public catalogue and detail pages.

    Why not Tailwind utilities: the host compiles its CSS once, at image
    build time, from whatever classes its content scan saw then — a utility
    used only by a newer engine release silently does not ship (most of the
    layout utilities these pages need are absent from the 0.31 bundle). So
    the pages keep Decidim's own component classes (.title-decorator,
    .decorator, .label, .button, .form-defaults) and everything layout-
    specific lives here, scoped under the .cs- prefix.

    Delivered through Decidim's :css_content slot, which the core layout
    yields in <head> right after the decidim_core stylesheet (so these
    rules win ties); Decidim's default CSP allows inline styles. Colours
    are Decidim's own palette tokens: the organisation's --secondary for
    links, the core gray-2 / gray-3 / background-2 values for text, rules
    and panels. %>
<% content_for :css_content do %>
<style>
  .cs-page { padding-top: 2.5rem; }
  .cs-page .title-decorator { margin-bottom: 2.25rem; overflow-wrap: anywhere; }
  .cs-lead { margin: 0; max-width: 42rem; font-size: 1.125rem; line-height: 1.6; color: #3e4c5c; }

  /* The register's shared header and view switch (catalogue / statistics),
     set in the civora.sk register: Source Sans, ink #0e1b2e, one blue
     #0b5cad, 1px rules. The active tab's ink line is a real element with a
     view-transition-name: between the two pages (both opt in below) the
     browser slides it from tab to tab and cross-fades the content. No JS;
     browsers without cross-document View Transitions just navigate. */
  .cs-switch { display: flex; gap: clamp(1.5rem, 4vw, 2.5rem); margin: 0 0 clamp(2rem, 4vw, 3rem); border-bottom: 1px solid #d5dce6; }
  .cs-switch .cs-switch__link { position: relative; display: inline-flex; align-items: center; gap: .5rem; padding: .875rem 0 .75rem; font-size: 1.0625rem; font-weight: 600; line-height: 1.2; color: #44546a; text-decoration: none; transition: color .15s ease; }
  .cs-switch .cs-switch__link:hover { text-decoration: none; }
  .cs-switch .cs-switch__link:hover { color: #0e1b2e; }
  .cs-switch .cs-switch__link:hover::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: #d5dce6; }
  .cs-switch .cs-switch__link[aria-current="page"] { color: #0e1b2e; }
  .cs-switch .cs-switch__link[aria-current="page"]:hover::after { content: none; }
  .cs-switch .cs-switch__link:focus-visible { outline: 3px solid #0b5cad; outline-offset: 3px; border-radius: 2px; }
  .cs-switch__icon { flex: none; width: 1.125rem; height: 1.125rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .cs-switch .cs-switch__link[aria-current="page"] .cs-switch__icon { color: #0b5cad; }
  .cs-switch__ink { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: #0b5cad; view-transition-name: cs-switch-ink; }
  .cs-head { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .cs-head__title { margin: 0; font-size: clamp(2.25rem, 1.4rem + 3vw, 3.5rem); font-weight: 700; line-height: 1.08; letter-spacing: -.02em; color: #0e1b2e; text-wrap: balance; overflow-wrap: anywhere; view-transition-name: cs-head-title; }
  .cs-head__lead { max-width: 44ch; margin: 1.25rem 0 0; font-size: 1.25rem; line-height: 1.5; color: #44546a; text-wrap: pretty; }

  @view-transition { navigation: auto; }
  ::view-transition-group(cs-switch-ink) { animation-duration: .42s; animation-timing-function: cubic-bezier(.16, 1, .3, 1); }
  ::view-transition-old(cs-head-title), ::view-transition-new(cs-head-title) { animation-duration: .28s; animation-timing-function: cubic-bezier(.16, 1, .3, 1); height: 100%; object-fit: none; object-position: left top; }
  ::view-transition-old(root) { animation: .18s cubic-bezier(.4, 0, 1, 1) both cs-vt-out; }
  ::view-transition-new(root) { animation: .32s cubic-bezier(.16, 1, .3, 1) .06s both cs-vt-in; }
  @keyframes cs-vt-out { to { opacity: 0; } }
  @keyframes cs-vt-in { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) {
    @view-transition { navigation: none; }
    .cs-switch .cs-switch__link { transition: none; }
  }

  /* Catalogue header: the compact title and the Zoznam | Štatistiky switch share
     one line (wrapping on phones), parted from the content by one hairline. The
     switch's ink line sits on that hairline. */
  .cs-reg { color: #0e1b2e; font-variant-numeric: lining-nums; }
  .cs-page.cs-reg--top { padding-top: 1.5rem; }
  .cs-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0 2rem; margin: 0 0 1.25rem; border-bottom: 1px solid #d5dce6; }
  .cs-top__title { margin: 0; padding-bottom: .5rem; font-size: clamp(1.375rem, 1.1rem + .9vw, 1.75rem); font-weight: 700; line-height: 1.2; letter-spacing: -.015em; color: #0e1b2e; overflow-wrap: anywhere; }
  .cs-top .cs-switch { margin: 0; border-bottom: 0; }

  /* Search and filter chips (#116): one GET form. The chips are native
     <details> popovers (no JavaScript); the panel opens under its chip, or in
     the flow on phones, so nothing overflows. A chip that holds a value says
     so in its label and is tinted. Square, flat, hairline. */
  .cs-find { margin: 0; }
  .cs-find__row { display: flex; gap: .5rem; }
  .cs-find__row input[type="text"] { flex: 1 1 auto; width: 100%; min-width: 0; margin: 0; }
  .cs-find__row .button { flex: none; justify-content: center; white-space: nowrap; }
  .cs-find ::placeholder { color: #44546a; opacity: 1; }
  .cs-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .cs-chip { position: relative; max-width: 100%; }
  .cs-chip__summary, .cs-menu__summary { display: inline-flex; align-items: center; gap: .5rem; max-width: 100%; list-style: none; cursor: pointer; }
  .cs-chip__summary::-webkit-details-marker, .cs-menu__summary::-webkit-details-marker { display: none; }
  .cs-chip__summary::after, .cs-menu__summary::after { content: ""; flex: none; width: .4375rem; height: .4375rem; margin: -.1875rem 0 0 .125rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); }
  .cs-chip[open] > .cs-chip__summary::after, .cs-menu[open] > .cs-menu__summary::after { margin-top: .1875rem; transform: rotate(-135deg); }
  .cs-chip__summary { padding: .375rem .75rem; border: 1px solid #d5dce6; background: #fff; font-size: .9375rem; font-weight: 600; line-height: 1.3; color: #0e1b2e; }
  .cs-chip__summary span { overflow-wrap: anywhere; }
  .cs-chip__summary:hover, .cs-chip[open] > .cs-chip__summary { border-color: #0e1b2e; }
  .cs-chip--on > .cs-chip__summary { border-color: #0b5cad; background: #f1f4f8; color: #084782; }
  .cs-reg summary:focus-visible { outline: 3px solid #0b5cad; outline-offset: 3px; border-radius: 2px; }
  .cs-chip__panel { position: absolute; top: calc(100% + .25rem); left: 0; z-index: 5; width: max-content; min-width: 16rem; max-width: min(22rem, calc(100vw - 2rem)); padding: 1rem; background: #fff; border: 1px solid #d5dce6; border-top: 2px solid #0e1b2e; }
  .cs-chip:nth-last-child(-n+2) > .cs-chip__panel { left: auto; right: 0; }
  .cs-chip__panel label { display: block; margin-bottom: .25rem; font-size: .875rem; font-weight: 600; color: #44546a; }
  .cs-chip__panel input, .cs-chip__panel select { width: 100%; min-width: 0; margin-bottom: 0; }
  .cs-chip__panel .cs-small { margin-top: .25rem; color: #44546a; }
  .cs-chip__pair { display: grid; min-width: 0; margin: 0; padding: 0; border: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
  .cs-chip__pair > div { min-width: 0; }
  .cs-chip__apply { margin-top: .75rem; }

  /* Applied filters: each a link that drops that one param. */
  .cs-active { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin-top: .75rem; }
  .cs-active__list { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .cs-reg .cs-tag { display: inline-flex; align-items: center; gap: .5rem; padding: .25rem .5rem .25rem .625rem; background: #f1f4f8; font-size: .9375rem; line-height: 1.3; color: #0e1b2e; text-decoration: none; overflow-wrap: anywhere; }
  .cs-reg .cs-tag:hover { color: #084782; text-decoration: underline; text-underline-offset: .18em; }
  .cs-tag__x { flex: none; width: .75rem; height: .75rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .cs-reg .cs-active__clear { font-size: .9375rem; font-weight: 600; color: #0b5cad; text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }
  .cs-reg .cs-active__clear:hover { color: #084782; text-decoration-thickness: 2px; }

  /* Results toolbar: one line above the list. Left, what the filtered set
     holds; right, sort / download / follow. Opens on the register's 2px ink
     rule. Menus are <details> of plain links. */
  .cs-bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .375rem 1.5rem; margin-top: 1.25rem; padding: .625rem 0; border-top: 2px solid #0e1b2e; }
  .cs-bar__sum { display: flex; flex-wrap: wrap; align-items: baseline; gap: .125rem .5rem; margin: 0; font-size: 1.0625rem; font-variant-numeric: tabular-nums lining-nums; }
  .cs-bar__figure { font-weight: 700; color: #0e1b2e; }
  .cs-bar__note { font-size: .9375rem; color: #44546a; }
  .cs-bar__sum > * + *::before { content: "·"; content: "·" / ""; margin-right: .5rem; font-weight: 400; color: #44546a; }
  .cs-bar__tools { display: flex; flex-wrap: wrap; align-items: center; gap: .125rem 1.25rem; }
  .cs-menu { position: relative; }
  .cs-menu__summary { padding: .25rem 0; font-size: .9375rem; font-weight: 600; color: #0b5cad; }
  .cs-menu__summary:hover { color: #084782; }
  .cs-menu__panel { position: absolute; top: calc(100% + .25rem); right: 0; z-index: 5; width: max-content; min-width: 13rem; max-width: min(20rem, calc(100vw - 2rem)); margin: 0; padding: .5rem 1rem .75rem; list-style: none; background: #fff; border: 1px solid #d5dce6; border-top: 2px solid #0e1b2e; box-shadow: 0 .5rem 1.5rem rgba(14, 27, 46, .12); }
  .cs-menu__panel ul { margin: 0; padding: 0; list-style: none; }
  .cs-menu__panel li + li { border-top: 1px solid #d5dce6; }
  .cs-menu__panel a { display: block; padding: .5rem 0; font-size: .9375rem; font-weight: 600; color: #0b5cad; text-decoration: none; }
  .cs-menu__panel a:hover { color: #084782; text-decoration: underline; text-underline-offset: .18em; }
  .cs-menu__panel a[aria-current] { color: #0e1b2e; font-weight: 700; text-decoration: none; cursor: default; }
  .cs-menu__panel .cs-small { margin-top: .5rem; color: #44546a; }
  .cs-reg .cs-bar__follow { display: inline-flex; align-items: center; gap: .375rem; padding: .25rem 0; font-size: .9375rem; font-weight: 600; color: #0b5cad; text-decoration: none; }
  .cs-reg .cs-bar__follow:hover { color: #084782; text-decoration: underline; text-underline-offset: .18em; }
  .cs-bar__icon { flex: none; width: 1.125rem; height: 1.125rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }

  .cs-filters-active__list { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .cs-filters-active .label { white-space: normal; overflow-wrap: anywhere; }

  .cs-opendata__title { margin: 0 0 .5rem; font-size: 1rem; font-weight: 600; color: #020203; }

  /* E-mail alerts pages (#121): the subscribe form, the confirmation, unsubscribe
     and message pages, all reusing the shared .cs-head. */
  .cs-alerts { margin: 0 0 1.5rem; }
  .cs-alerts__title { margin: 0 0 .5rem; font-size: 1rem; font-weight: 600; color: #020203; }
  .cs-alerts .cs-small { margin: 0 0 .75rem; max-width: 42rem; }
  .cs-alerts__form { max-width: 42rem; margin-top: .75rem; }
  .cs-alerts__field { margin-bottom: .75rem; }
  .cs-alerts__field label { display: block; margin-bottom: .5rem; font-weight: 600; color: #020203; }
  .cs-alerts__field input { width: 100%; min-width: 0; }
  .cs-alerts__error { margin: .5rem 0 0; font-weight: 600; color: #a1161b; }
  .cs-alerts-page .cs-head { padding-bottom: 1.5rem; }
  .cs-alerts-page .cs-filters-active__list { margin-bottom: 1rem; }
  .cs-alerts__search { margin: 0 0 1rem; padding: .75rem 0; border-top: 2px solid #0e1b2e; border-bottom: 1px solid #d5dce6; font-size: 1.0625rem; font-weight: 600; color: #0e1b2e; overflow-wrap: anywhere; }

  /* Supplier page (#117): summary facts above the register. */
  .cs-supplier { margin: 0 0 2rem; }
  .cs-supplier__facts { margin: 0 0 .75rem; }
  .cs-supplier__facts dd + dd { margin-top: .25rem; }
  .cs-supplier__list-title { margin: 0 0 .75rem; }
  .cs-years { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin: 0; padding: 0; list-style: none; }
  .cs-num { font-variant-numeric: tabular-nums; }

  /* Statistics page (#118), set as a statistical yearbook in the civora.sk
     register: white ground, ink and blue, sections opened by a 2px ink rule,
     rows parted by 1px rules, tabular lining figures, flat bars inside the
     table (decoration, aria-hidden: the number beside each bar is the data;
     width from --cs-bar). Tokens are scoped to .cs-yb so the rest of the
     catalogue keeps Decidim's palette. */
  .cs-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .cs-yb { --yb-ink: #0e1b2e; --yb-muted: #44546a; --yb-blue: #0b5cad; --yb-blue-dark: #084782; --yb-rule: #d5dce6; --yb-tint: #f1f4f8; --yb-crz: #75869b; color: var(--yb-ink); font-variant-numeric: lining-nums; }
  .cs-yb ::selection { background: #bcd7f2; color: var(--yb-ink); }
  .cs-yb a { color: var(--yb-blue); text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 1px; }
  .cs-yb a:hover { color: var(--yb-blue-dark); text-decoration-thickness: 2px; }
  .cs-yb a:focus-visible { outline: 3px solid var(--yb-blue); outline-offset: 3px; border-radius: 2px; }
  .cs-yb__head { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .cs-yb__asof { margin: .75rem 0 0; font-size: .9375rem; color: var(--yb-muted); }

  .cs-yb__summary { margin: 0 0 clamp(3rem, 6vw, 4.5rem); }
  .cs-yb__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; border-top: 2px solid var(--yb-ink); border-bottom: 1px solid var(--yb-rule); }
  .cs-yb__fact { min-width: 0; padding: 1.25rem 0 1.375rem 1rem; border-left: 1px solid var(--yb-rule); }
  .cs-yb__fact:nth-child(odd) { padding-left: 0; border-left: 0; }
  .cs-yb__fact:nth-child(n+3) { border-top: 1px solid var(--yb-rule); }
  .cs-yb__fact dt { font-size: .9375rem; font-weight: 600; line-height: 1.3; color: var(--yb-muted); }
  .cs-yb__figure { margin: .5rem 0 0; font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); font-weight: 700; line-height: 1; letter-spacing: -.025em; color: var(--yb-ink); font-variant-numeric: tabular-nums lining-nums; overflow-wrap: anywhere; }
  .cs-yb__amount { margin: .625rem 0 0; font-size: 1.0625rem; font-weight: 600; color: var(--yb-ink); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .cs-yb__aside { display: block; margin: .25rem 0 0; font-size: .875rem; font-weight: 400; line-height: 1.4; color: var(--yb-muted); }

  .cs-yb__tab { margin: 0 0 clamp(3rem, 6vw, 4.5rem); }
  .cs-yb__tab-title { margin: 0; padding-top: 1rem; border-top: 2px solid var(--yb-ink); font-size: clamp(1.375rem, 1.1rem + .9vw, 1.75rem); font-weight: 700; line-height: 1.2; letter-spacing: -.015em; color: var(--yb-ink); text-wrap: balance; }
  .cs-yb__no { margin-right: .5em; color: var(--yb-blue); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cs-yb__unit { max-width: 72ch; margin: .5rem 0 1.25rem; font-size: 1rem; color: var(--yb-muted); }
  .cs-yb__table { width: 100%; border-collapse: collapse; font-size: 1.0625rem; font-variant-numeric: tabular-nums lining-nums; }
  .cs-yb__table thead th { padding: 0 1rem .5rem 0; border-bottom: 1px solid var(--yb-ink); font-size: .875rem; font-weight: 600; text-align: left; vertical-align: bottom; white-space: nowrap; color: var(--yb-muted); }
  .cs-yb__table tbody th, .cs-yb__table tbody td { padding: .75rem 1rem .75rem 0; border-bottom: 1px solid var(--yb-rule); text-align: left; vertical-align: baseline; }
  .cs-yb__table tbody th { font-weight: 600; color: var(--yb-ink); overflow-wrap: break-word; -webkit-hyphens: auto; hyphens: auto; }
  .cs-yb__table tr > :last-child { padding-right: 0; }
  .cs-yb__table .cs-yb__num { text-align: right; white-space: nowrap; }
  .cs-yb__table .cs-yb__num + .cs-yb__num { padding-left: 2rem; }
  .cs-yb__table--rank tbody th { -webkit-hyphens: manual; hyphens: manual; }
  .cs-yb__table td:has(.cs-yb__cell) { width: 46%; }
  .cs-yb__table--rank td:has(.cs-yb__cell) { width: 32%; }
  .cs-yb__zero th, .cs-yb__zero td, .cs-yb__zero .cs-yb__count { color: var(--yb-muted); font-weight: 400; }
  .cs-yb__flag { margin-left: .375rem; font-weight: 400; color: var(--yb-muted); white-space: nowrap; -webkit-hyphens: none; hyphens: none; }
  .cs-yb__cell { display: flex; align-items: center; justify-content: flex-end; gap: .75rem; }
  .cs-yb__bar { flex: 1 1 auto; min-width: 2.5rem; height: .625rem; background: var(--yb-tint); }
  .cs-yb__bar > span { display: block; width: var(--cs-bar, 0%); height: 100%; background: var(--yb-blue); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cs-yb__count { min-width: 3ch; font-weight: 600; text-align: right; color: var(--yb-ink); }
  .cs-yb__amt { display: block; font-weight: 600; white-space: nowrap; color: var(--yb-ink); }
  .cs-yb__none { color: var(--yb-muted); }
  .cs-yb__table .cs-yb__rank { width: 3.5rem; }
  .cs-yb__table tbody td.cs-yb__rank { font-size: 1.25rem; font-weight: 700; line-height: 1.2; color: var(--yb-blue); }
  .cs-yb__ico { display: block; margin-top: .125rem; font-size: .875rem; font-weight: 400; color: var(--yb-muted); }
  .cs-yb__split { display: flex; height: .875rem; margin: 0 0 1.25rem; background: var(--yb-crz); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cs-yb__split-own { display: block; width: var(--cs-bar, 0%); background: var(--yb-blue); }
  .cs-yb__share-inline { display: none; }
  .cs-yb__keyed { display: inline-flex; align-items: baseline; gap: .5rem; }
  .cs-yb__key { display: inline-block; flex: none; width: .75rem; height: .75rem; background: var(--yb-blue); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .cs-yb__key--crz { background: var(--yb-crz); }
  .cs-yb__src { max-width: 72ch; margin: .75rem 0 0; font-size: .875rem; line-height: 1.5; color: var(--yb-muted); }
  .cs-yb__next { display: flex; flex-wrap: wrap; gap: .75rem 2rem; margin: 2rem 0 0; padding-top: 1.25rem; border-top: 2px solid var(--yb-ink); font-size: 1.0625rem; font-weight: 600; }
  .cs-yb__note { max-width: 72ch; margin: 0; padding-top: 1.25rem; border-top: 1px solid var(--yb-rule); font-size: .9375rem; line-height: 1.55; color: var(--yb-muted); }
  .cs-yb__empty { margin: 0; padding: 2.5rem 0; border-top: 2px solid var(--yb-ink); border-bottom: 1px solid var(--yb-rule); font-size: 1.125rem; color: var(--yb-muted); }

  .cs-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #e1e5ef; border-bottom: 1px solid #e1e5ef; }
  .cs-list > li + li { border-top: 1px solid #e1e5ef; }

  /* The register (catalogue, supplier page, in-space list): hairline-separated
     two-line rows. Line 1: date | title | amount; line 2, muted: contractors,
     reference, CRZ provenance. About 68px a row. */
  .cs-reg .cs-list { border-color: #d5dce6; }
  .cs-reg .cs-list > li + li { border-color: #d5dce6; }
  .cs-row { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) auto; grid-template-areas: "date title amount" ". meta meta"; column-gap: 1rem; row-gap: .125rem; align-items: baseline; padding: .75rem 0; }
  .cs-row__date { grid-area: date; font-size: .9375rem; color: #44546a; font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }
  .cs-row__date--meta { display: none; }
  .cs-row__title { grid-area: title; min-width: 0; font-size: 1.0625rem; font-weight: 600; line-height: 1.35; color: #0e1b2e; text-decoration: none; overflow-wrap: anywhere; }
  .cs-row__title:hover { color: #0b5cad; text-decoration: underline; text-underline-offset: .18em; }
  .cs-row__amount { grid-area: amount; font-weight: 600; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
  .cs-row__meta { grid-area: meta; display: flex; flex-wrap: wrap; gap: 0 .5rem; min-width: 0; margin: 0; font-size: .875rem; line-height: 1.45; color: #44546a; font-variant-numeric: tabular-nums lining-nums; }
  .cs-row__meta > *:not(:last-child)::after { content: "·"; content: "·" / ""; margin-left: .5rem; }
  .cs-row__parties { min-width: 0; overflow-wrap: anywhere; }
  .cs-row__src { white-space: nowrap; }
