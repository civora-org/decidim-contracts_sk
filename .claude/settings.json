{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__agent-review__agent_review_status",
      "mcp__agent-review__agent_review_github_status",
      "mcp__agent-review__agent_review_checkpoint",
      "mcp__agent-review__agent_review_record_intent"
    ],
    "ask": [
      "WebFetch",
      "WebSearch",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(docker compose:*)",
      "mcp__agent-review__agent_review_start",
      "mcp__agent-review__agent_review_rollback",
      "mcp__agent-review__agent_review_publish_pr",
      "mcp__agent-review__agent_review_update_github_review"
    ],
    "deny": [
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(docker system prune:*)",
      "Bash(rm:*)",
      "Bash(bin/rails db:drop:*)",
      "Bash(bin/rails db:reset:*)",
      "Bash(bundle exec rails db:drop:*)",
      "Bash(bundle exec rails db:reset:*)",
      "Bash(bundle exec rake db:drop:*)",
      "Bash(bundle exec rake db:reset:*)"
    ]
  },
  "enabledMcpjsonServers": ["agent-review", "slov-lex", "playwright"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/../agent-review/bin/agent-review-claude-hook.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
